<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_head" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:text="알림 타이머" android:textColor="#FF3DBB91" android:textSize="15sp" android:textStyle="bold"/>
        <ImageView android:id="@+id/w_all_start" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn2" android:padding="9dp" android:src="@drawable/ic_play" android:tint="#FFE4EBE7" android:contentDescription="전체 시작"/>
        <ImageView android:id="@+id/w_all_pause" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn2" android:padding="9dp" android:src="@drawable/ic_pause" android:tint="#FFE4EBE7" android:contentDescription="전체 일시정지"/>
        <ImageView android:id="@+id/w_all_reset" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn2" android:padding="9dp" android:src="@drawable/ic_reset" android:tint="#FFE4EBE7" android:contentDescription="전체 초기화"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/r0" android:layout_width="match_parent" android:layout_height="46dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/r0_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFE4EBE7" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/r0_stat" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FF8A9893" android:textSize="11sp" android:maxLines="1"/>
        </LinearLayout>
        <Chronometer android:id="@+id/r0_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="10dp" android:textColor="#FFE4EBE7" android:textSize="22sp" android:textStyle="bold" android:fontFamily="monospace" android:visibility="gone"/>
        <TextView android:id="@+id/r0_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="10dp" android:textColor="#FFE4EBE7" android:textSize="22sp" android:textStyle="bold" android:fontFamily="monospace" android:text="00:00"/>
        <ImageView android:id="@+id/r0_btn" android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/widget_btn" android:padding="9dp" android:src="@drawable/ic_play"
            android:tint="#FF062218" android:contentDescription="시작/일시정지"/>
    </LinearLayout>
